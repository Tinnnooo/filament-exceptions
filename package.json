{
    "private": true,
    "type": "module",
    "scripts": {
        "dev:styles": "npx @tailwindcss/cli -i resources/css/filament-exceptions.css -o resources/dist/filament-exceptions.css --watch",
        "dev:scripts": "node bin/build.js --dev",
        "build:styles": "npx @tailwindcss/cli -i resources/css/filament-exceptions.css -o resources/dist/filament-exceptions.css --minify",
        "build:scripts": "node bin/build.js",
        "dev": "npm-run-all --parallel dev:*",
        "build": "npm-run-all build:*",
        "prettier": "npx prettier --write ."
    },
    "devDependencies": {
        "esbuild": "^0.25.10",
        "npm-run-all": "^4.1.5",
        "prettier": "^3.0.0",
        "prettier-plugin-blade": "^1.6.10",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "shiki": "^3.13.0",
        "tailwindcss": "^4.1.12",
        "tippy.js": "^6.3.7",
        "tw-animate-css": "^1.3.7"
    }
}
